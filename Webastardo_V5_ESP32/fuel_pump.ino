//*******************************************************************************************
// Fuel dosing pump - discrete pulses generated by a 1ms hardware timer interrupt.
//
// Safety: the pulses only continue while the main loop keeps calling Fuel_Keepalive().
// If the loop hangs (or the fuel code isn't being run) the ISR stops the pump within
// FUEL_KEEPALIVE_MS, even though the timer is still running.
//*******************************************************************************************
hw_timer_t *fuel_timer = NULL;

const uint32_t FUEL_TICK_US = 1000;        // ISR runs every 1ms
const uint32_t FUEL_KEEPALIVE_MS = 1500;   // Pump stops if not re-armed within this time

//Shared with the ISR.  Volatile is important!
volatile uint32_t pulsePeriod_us = 0;      // 0 = pump off
volatile uint32_t pulseLength_us = 0;
volatile uint32_t pulseElapsed_us = 0;     // Position within the current period
volatile uint32_t fuelKeepalive_ms = 0;    // Counts down in the ISR
volatile uint32_t fuelPulseCount = 0;      // Total pulses delivered (diagnostics)
portMUX_TYPE fuelMux = portMUX_INITIALIZER_UNLOCKED;

//*******************************************************************************************
// Timer Callback - this bit actually switches the pin on & off
//*******************************************************************************************
void ARDUINO_ISR_ATTR onFuelTimer() {
  portENTER_CRITICAL_ISR(&fuelMux);
  bool pin_high = false;

  if (fuelKeepalive_ms > 0) fuelKeepalive_ms = fuelKeepalive_ms - 1;

  if (pulsePeriod_us > 0 && fuelKeepalive_ms > 0) {
    if (pulseElapsed_us == 0) fuelPulseCount = fuelPulseCount + 1;         //Start of a new pulse
    pin_high = (pulseElapsed_us < pulseLength_us);
    pulseElapsed_us = pulseElapsed_us + FUEL_TICK_US;
    if (pulseElapsed_us >= pulsePeriod_us) pulseElapsed_us = 0;
  } else {
    pulseElapsed_us = 0;    //Next start begins with a fresh pulse
  }
  gpio_set_level((gpio_num_t)fuel_pump_pin, pin_high);
  portEXIT_CRITICAL_ISR(&fuelMux);
}

//*******************************************************************************************
// Start the 1ms timer
//*******************************************************************************************
void Fuel_Pump_Setup() {
  fuel_timer = timerBegin(1000000);              // 1MHz timer clock
  timerAttachInterrupt(fuel_timer, &onFuelTimer);
  timerAlarm(fuel_timer, FUEL_TICK_US, true, 0); // Repeat every 1ms, forever
}

//*******************************************************************************************
// Called every loop.  If this stops being called, the fuel pump stops.
//*******************************************************************************************
void Fuel_Keepalive() {
  portENTER_CRITICAL(&fuelMux);
  fuelKeepalive_ms = FUEL_KEEPALIVE_MS;
  portEXIT_CRITICAL(&fuelMux);
}

//*******************************************************************************************
// Set the fuel pump rate - the timer delivers the pulses in the background
// It doesn't need calling other than to change the delivery rate
// fuelneed is in Hz for a 60 pump.  Smaller pumps are pulsed proportionally faster.
//*******************************************************************************************
void Fuel_Rate(int pumpsize, float fuelneed) {
  fuel_need = fuelneed; //Global used elsewhere

  //Set the pulse length required by the size of pump
  float pulse_length_ms;
  if (pumpsize == 0)
    pulse_length_ms = 2;  //This is a special case for James's silent fuel pump jamesbrowningsmith@yahoo.co.uk
  else if (pumpsize == 22)
    pulse_length_ms = 9;
  else if (pumpsize == 33)
    pulse_length_ms = 18;
  else
    pulse_length_ms = 36;

  //A bigger pump delivers more fuel per pulse, so a smaller pump is pulsed faster to deliver the same amount.
  //(As V2/V3.  V4 had this inverted and also truncated the rate to whole Hz)
  float Pump_Hz = fuelneed;
  if (pumpsize > 0) Pump_Hz = fuelneed * 60.0 / pumpsize;

  uint32_t period_us = 0;
  uint32_t length_us = 0;
  if (Pump_Hz > 0.01 && !bench_mode) {
    period_us = (uint32_t)(1000000.0 / Pump_Hz);
    length_us = (uint32_t)(pulse_length_ms * 1000.0);
    //Always leave at least as long off as on
    if (period_us < 2 * length_us) period_us = 2 * length_us;
  }

  //Only update if it's changed
  if (period_us != pulsePeriod_us || length_us != pulseLength_us) {
    portENTER_CRITICAL(&fuelMux);
    pulsePeriod_us = period_us;
    pulseLength_us = length_us;
    //pulseElapsed_us carries on, so a rate change never adds an extra pulse.
    //If it's already past the new (shorter) period the ISR wraps it on the next tick.
    portEXIT_CRITICAL(&fuelMux);
  }
}

//*******************************************************************************************
// Current pump frequency in Hz (for display)
//*******************************************************************************************
float Fuel_Pump_Hz() {
  return pulsePeriod_us > 0 ? 1000000.0 / pulsePeriod_us : 0;
}
